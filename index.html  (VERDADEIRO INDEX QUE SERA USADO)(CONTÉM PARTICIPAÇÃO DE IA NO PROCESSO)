    <script>

        let busca = document.getElementById("busca");

        busca.addEventListener("input", function() {

            let texto = busca.value.toLowerCase();

            let restaurantes = document.querySelectorAll(".card");
            let pratos = document.querySelectorAll(".card-prato");

            let encontrados = 0;

            restaurantes.forEach(function(card) {

                let nome = card.getAttribute("data-nome").toLowerCase();

                if (nome.includes(texto)) {
                    card.style.display = "block";
                    encontrados++;
                } else {
                    card.style.display = "none";
                }

            });

            pratos.forEach(function(prato) {

                let nome = prato.getAttribute("data-nome").toLowerCase();

                if (nome.includes(texto)) {
                    prato.style.display = "block";
                } else {
                    prato.style.display = "none";
                }

            });

            if (texto == "") {
                document.getElementById("semResultado").style.display = "none";
            } else if (encontrados == 0) {
                document.getElementById("semResultado").style.display = "block";
            } else {
                document.getElementById("semResultado").style.display = "none";
            }

        });

    </script>

