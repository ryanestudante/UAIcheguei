* {
    margin: 0;
    padding: 0;
}

body {
    font-family: Poppins, Arial, sans-serif;
    background-color: #f5f5f5;
    color: #333;
}


/* CABEÇALHO */

.cabecalho {
    background-color: white;
    padding: 15px 5%;
}


/* PARTE DE CIMA */

.topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}


.logo {
    width: 100px;
}


.endereco {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 14px;
}


.endereco small {
    display: block;
    color: #777;
}


.endereco strong {
    color: #f27029;
}


.endereco p {
    font-size: 12px;
    color: #777;
}


/* PESQUISA */

.pesquisa {
    display: flex;
    align-items: center;
    background-color: #f5f5f5;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 0 10px;
}


.pesquisa input {
    width: 350px;
    padding: 12px;
    border: none;
    background-color: transparent;
    outline: none;
}


/* OPÇÕES */

.opcao {
    text-align: center;
    cursor: pointer;
    margin-left: -8px;
}


.icone {
    font-size: 22px;
}


.opcao p {
    font-size: 14px;
}


.opcao a {
    color: #333;
    text-decoration: none;
    font-size: 14px;
}


.opcao a:hover {
    color: #f27029;
}


/* PERFIL */

.perfil {
    text-align: center;
    margin-left: -8px;
}


.foto {
    font-size: 20px;
    cursor: pointer;
}


.foto a {
    text-decoration: none;
}


/* MENU */

.menu {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid #eee;
}


.menu a {
    color: #333;
    text-decoration: none;
    font-size: 14px;
}


.menu a:hover {
    color: #f27029;
}


.menu span {
    margin-left: 4px;
}


.config {
    font-size: 18px !important;
}


/* DESTAQUE */

.destaque {
    background-color: #f27029;
    color: white;
    padding: 50px 8%;
    margin-bottom: 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}


.texto {
    width: 55%;
}


.texto h1 {
    font-size: 35px;
    margin-bottom: 10px;
}


.texto p {
    font-size: 18px;
}


/* OFERTAS */

.ofertas {
    background-color: white;
    color: #333;
    width: 300px;
    padding: 25px;
    border-radius: 10px;
}


.ofertas h2 {
    margin-bottom: 10px;
    color: #f27029;
}


.ofertas p {
    margin-bottom: 15px;
}


.ofertas button {
    background-color: #f27029;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 5px;
    cursor: pointer;
}


.ofertas button:hover {
    background-color: #d95d1c;
}


/* RESTAURANTES */

.restaurantes {
    width: 90%;
    margin: 30px auto;
}


.titulo {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}


.titulo h2 {
    font-size: 25px;
}


.titulo a {
    color: #f27029;
    text-decoration: none;
}


/* CARDS */

.cards {
    display: flex;
    gap: 20px;
}


.card {
    background-color: white;
    width: 25%;
    border-radius: 10px;
    overflow: hidden;
    border: 2px solid transparent;
}


.card:hover {
    border: 2px solid #f27029;
}


.foto-comida {
    position: relative;
}


.foto-comida img {
    width: 100%;
    height: 180px;
    object-fit: cover;
}


.promocao {
    position: absolute;
    top: 10px;
    left: 10px;
    background-color: #f27029;
    color: white;
    padding: 5px 10px;
    border-radius: 5px;
}


/* INFORMAÇÕES */

.info {
    padding: 15px;
}


.info h3 {
    margin-bottom: 5px;
}


.nota {
    margin-bottom: 8px;
}


.nota span {
    color: #777;
}


.info p {
    color: #777;
    margin-bottom: 10px;
}


.entrega {
    color: #f27029;
    font-size: 14px;
}


/* OFERTA DE BAIXO */

.oferta {
    width: 80%;
    margin: 50px auto;
    padding: 30px;
    background-color: white;
    text-align: center;
    border-radius: 10px;
}


.oferta h2 {
    margin-bottom: 10px;
}


.oferta p {
    margin-bottom: 15px;
}


.oferta button {
    background-color: #f27029;
    color: white;
    border: none;
    padding: 12px 25px;
    border-radius: 5px;
    cursor: pointer;
}


.oferta button:hover {
    background-color: #d95d1c;
}


/* RODAPÉ */

footer {
    background-color: #222;
    color: white;
    text-align: center;
    padding: 30px;
    margin-top: 50px;
}


footer h3 {
    color: #f27029;
    margin-bottom: 10px;
}


footer p {
    margin-bottom: 5px;
}
