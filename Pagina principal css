/* =========================
   RESET
========================= */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --primary: #ff5a1f;
  --primary-dark: #e94b14;
  --primary-light: #fff1e9;
  --background: #f8f8f8;
  --white: #ffffff;
  --text: #222222;
  --muted: #777777;
  --border: #eeeeee;
  --success: #16a34a;
}

body {
  font-family: Poppins, Arial, Helvetica, sans-serif;
  color: var(--text);
  background: var(--background);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input {
  font: inherit;
}


/* =========================
   CONTAINER
========================= */

.container {
  width: min(1800px, 96%);
  margin: 0 auto;
}


/* =========================
   HEADER (original)
========================= */

.logo-area {
  display: flex;
  align-items: right;
  gap: 10px;
}

.header {
  background: var(--white);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-content {
  min-height: 70px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.logo {
  color: var(--primary);
  width: 100px;
  height: 100px;
  object-fit: contain;
}

.location {
  font-size: 14px;
}

.nav {
  display: flex;
  align-items: center;
  gap: 50px;
}

.nav a {
  font-size: 20px;
  font-weight: 600;
}

.nav a:hover {
  color: var(--primary);
}


/* =========================
   HEADER V2 (com busca, favoritos, carrinho e avatar)
========================= */

.header-content-v2 {
  min-height: 90px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.header-content-v2 .logo {
  width: 90px;
  height: 90px;
  flex-shrink: 0;
}

.location-v2 {
  display: flex;
  align-items: center;
  gap: 6px;

  font-size: 13px;
  color: var(--muted);
  line-height: 1.4;
  white-space: nowrap;
}

.location-v2 svg {
  width: 20px;
  height: 20px;
  color: var(--primary);
  flex-shrink: 0;
}

.location-v2 strong {
  display: block;
  font-size: 15px;
  color: var(--text);
}

.location-v2 .street {
  display: block;
  color: var(--primary);
  font-size: 12px;
  font-weight: 600;
}

.search-v2 {
  flex: 1;
  max-width: 480px;

  display: flex;
  align-items: center;
  gap: 10px;

  background: var(--background);
  border: 1px solid var(--border);
  border-radius: 999px;

  padding: 10px 18px;
}

.search-v2 svg {
  width: 18px;
  height: 18px;
  color: var(--muted);
  flex-shrink: 0;
}

.search-v2 input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  color: var(--text);
  font-size: 14px;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 26px;
  flex-shrink: 0;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;

  font-size: 12px;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
}

.action-item svg {
  width: 22px;
  height: 22px;
}

.action-item:hover {
  color: var(--primary);
}

.avatar {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--primary-light);
}


/* =========================
   SUBMENU (categorias no header)
========================= */

.subnav {
  border-top: 1px solid var(--border);
}

.subnav-content {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 36px;

  padding: 14px 0;
}

.subnav-item {
  display: flex;
  align-items: center;
  gap: 8px;

  font-size: 14px;
  font-weight: 600;
  color: var(--muted);
}

.subnav-item svg {
  width: 18px;
  height: 18px;
}

.subnav-item:hover,
.subnav-item.active {
  color: var(--primary);
}


/* =========================
   HERO
========================= */

.hero-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
}

.hero-img {
  width: 300px;
  height: 250px;
  object-fit: contain;
}

.hero {
  background: var(--primary);
  color: white;
  padding: 70px 0;
}

.hero h1 {
  font-size: 42px;
  margin-bottom: 12px;
}

.hero p {
  font-size: 18px;
  margin-bottom: 30px;
}

.search {
  max-width: 650px;

  display: flex;

  background: white;
  padding: 6px;
  border-radius: 10px;
}

.search input {
  flex: 1;

  border: none;
  outline: none;

  padding: 14px;
  color: var(--text);
}

.search button {
  border: none;
  border-radius: 7px;

  padding: 0 25px;

  background: var(--primary);
  color: white;

  cursor: pointer;
  font-weight: bold;
}

.search button:hover {
  background: var(--primary-dark);
}


/* =========================
   CATEGORIAS
========================= */

.categories {
  padding: 40px 0 20px;
}

.categories h2,
.restaurants h2 {
  font-size: 24px;
  margin-bottom: 20px;
}

.category-list {
  display: flex;
  gap: 12px;
  overflow-x: auto;

  padding-bottom: 10px;
}

.category {
  min-width: 130px;

  border: 1px solid var(--border);
  background: white;

  border-radius: 10px;
  padding: 18px;

  cursor: pointer;

  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;

  transition: 0.2s;
}

.category span {
  font-size: 30px;
}

.category:hover {
  border-color: var(--primary);
  color: var(--primary);
  transform: translateY(-2px);
}


/* =========================
   RESTAURANTES
========================= */

.restaurants {
  padding: 30px 0 70px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-header a {
  color: var(--primary);
  font-weight: bold;
}

.restaurant-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 22px;
}


/* CARD */

.restaurant-card {
  background: white;
  border-radius: 12px;
  overflow: hidden;

  border: 1px solid var(--border);

  transition: 0.2s;
}

.restaurant-card:hover {
  transform: translateY(-4px);

  box-shadow:
    0 8px 25px rgba(0, 0, 0, 0.08);
}


/* IMAGEM */

.restaurant-image {
  height: 175px;
  position: relative;
}

.restaurant-image img {
  width: 100%;
  height: 100%;

  object-fit: cover;
}

.discount {
  position: absolute;

  top: 12px;
  left: 12px;

  background: var(--primary);
  color: white;

  padding: 6px 9px;

  border-radius: 5px;

  font-size: 12px;
  font-weight: bold;
}


/* INFORMAÇÕES */

.restaurant-info {
  padding: 16px;
}

.restaurant-info h3 {
  font-size: 19px;
  margin-bottom: 8px;
}

.rating {
  font-size: 14px;
  font-weight: bold;
}

.rating span {
  color: var(--muted);
  font-weight: normal;
}

.restaurant-info p {
  color: var(--muted);
  font-size: 14px;

  margin: 8px 0;
}

.delivery {
  color: var(--success);

  font-size: 13px;
  font-weight: bold;
}


/* =========================
   CARRINHO
========================= */

.cart {
  position: fixed;

  right: 20px;
  bottom: 20px;

  width: 340px;

  background: white;

  border-radius: 14px;

  box-shadow:
    0 10px 40px rgba(0, 0, 0, 0.15);

  overflow: hidden;

  z-index: 200;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 18px;

  border-bottom: 1px solid var(--border);
}

.cart-header h2 {
  font-size: 18px;
}

.close-cart {
  border: none;
  background: none;

  font-size: 25px;

  cursor: pointer;
}

.cart-items {
  padding: 15px;
  min-height: 80px;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  gap: 15px;

  font-size: 14px;
}

.cart-item small {
  display: block;
  color: var(--muted);

  margin-top: 4px;
}

.cart-footer {
  padding: 15px;

  border-top: 1px solid var(--border);
}

.cart-total {
  display: flex;
  justify-content: space-between;

  margin-bottom: 15px;
}

.checkout {
  width: 100%;

  padding: 14px;

  border: none;
  border-radius: 8px;

  background: var(--primary);
  color: white;

  font-weight: bold;

  cursor: pointer;
}

.checkout:hover {
  background: var(--primary-dark);
}


/* =========================
   PÁGINA DE PERFIL / INFORMAÇÕES DE USUÁRIO
========================= */

.profile-page {
  position: relative;
  overflow: hidden;
  padding: 40px 0 80px;
}

.profile-page::before {
  content: "";
  position: absolute;
  top: -60px;
  right: -60px;
  width: 260px;
  height: 220px;
  background-image: radial-gradient(circle, var(--primary-light) 2.5px, transparent 2.5px);
  background-size: 16px 16px;
  opacity: 0.9;
  z-index: 0;
}

.profile-page::after {
  content: "";
  position: absolute;
  bottom: -140px;
  right: -120px;
  width: 420px;
  height: 420px;
  background: var(--primary-light);
  border-radius: 50%;
  z-index: 0;
}

.profile-page .container {
  position: relative;
  z-index: 1;
}

.page-title {
  display: flex;
  align-items: flex-start;
  gap: 16px;

  margin-bottom: 24px;
}

.page-title-icon {
  width: 44px;
  height: 44px;
  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;
  background: var(--primary);
  color: white;
  font-size: 20px;
}

.page-title h1 {
  font-size: 24px;
  margin-bottom: 4px;
}

.page-title p {
  color: var(--muted);
  font-size: 14px;
}

.profile-card {
  background: var(--white);
  border-radius: 18px;
  padding: 32px clamp(20px, 4vw, 48px);

  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
}

.form-section + .form-section {
  margin-top: 28px;
}

.form-section h2 {
  display: flex;
  align-items: center;
  gap: 10px;

  font-size: 17px;
  color: var(--primary);

  padding-bottom: 14px;
  margin-bottom: 22px;

  border-bottom: 2px solid var(--primary-light);
}

.form-section h2 span {
  font-size: 18px;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px 24px;
}

.form-group.full {
  grid-column: 1 / -1;
}

.form-group label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: var(--muted);
  margin-bottom: 8px;
}

.form-group input {
  width: 100%;

  border: 1px solid var(--border);
  border-radius: 10px;

  padding: 13px 16px;

  color: var(--text);
  background: var(--white);

  outline: none;
  transition: 0.2s;
}

.form-group input::placeholder {
  color: #b7b7b7;
}

.form-group input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px var(--primary-light);
}

.form-actions {
  display: flex;
  justify-content: flex-end;

  margin-top: 32px;
}

.btn-save {
  border: none;
  border-radius: 10px;

  padding: 14px 34px;

  background: var(--primary);
  color: white;

  font-weight: bold;
  font-size: 15px;

  cursor: pointer;
  transition: 0.2s;
}

.btn-save:hover {
  background: var(--primary-dark);
}


/* =========================
   FOOTER
========================= */

.footer {
  background: #222;
  color: #aaa;

  padding: 30px 0;

  text-align: center;

  font-size: 13px;
}


/* =========================
   TELAS GRANDES
========================= */

@media (min-width: 1300px) {

  .restaurant-grid {
    grid-template-columns: repeat(4, 1fr);
  }

}

@media (min-width: 1700px) {

  .restaurant-grid {
    grid-template-columns: repeat(5, 1fr);
  }

  .category {
    min-width: 150px;
  }

}


/* =========================
   RESPONSIVO
========================= */

@media (max-width: 900px) {

  .restaurant-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .location {
    display: none;
  }

  .location-v2 {
    display: none;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

}


@media (max-width: 600px) {

  .header-content {
    min-height: 60px;
  }

  .nav {
    gap: 12px;
  }

  .header-content-v2 {
    flex-wrap: wrap;
    min-height: auto;
    padding: 14px 0;
  }

  .search-v2 {
    order: 3;
    max-width: 100%;
    width: 100%;
  }

  .action-item span.action-label {
    display: none;
  }

  .subnav-content {
    justify-content: flex-start;
    overflow-x: auto;
    gap: 22px;
  }

  .hero {
    padding: 45px 0;
  }

  .hero h1 {
    font-size: 30px;
  }

  .hero p {
    font-size: 16px;
  }

  .search {
    flex-direction: column;
    gap: 5px;
  }

  .search button {
    padding: 12px;
  }

  .restaurant-grid {
    grid-template-columns: 1fr;
  }

  .cart {
    left: 10px;
    right: 10px;
    bottom: 10px;

    width: auto;
  }

  .profile-card {
    padding: 24px 18px;
  }

}
