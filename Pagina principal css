* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


body {
    background-color: #e15800;
    background-image: url("https://uploads.onecompiler.io/44g7ujbgc/1783699274529/C%C3%B3pia%20de%20UAIcheguei%20(1).png");
    background-size: cover;
    background-position: center;
    font-family: Arial, sans-serif;
}


/* CONTEÚDO PRINCIPAL */

.container {
    display: flex;
    justify-content: space-around;
    align-items: center;
    min-height: 100vh;
    padding: 20px;
}


/* CAIXA BRANCA */

.caixa-branca {
    background-color: white;
    padding: 25px;
    border-radius: 20px;
    width: 500px;
    height: 600px;
    text-align: center;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
}


/* TÍTULOS */

.titulo-laranja {
    color: #e15800;
    margin-bottom: 5px;
}


.titulo-preto {
    color: black;
    margin-bottom: 10px;
}


.descricao {
    color: #D3D3D3;
    font-size: 16px;
    margin-bottom: 25px;
}


/* CAMPOS */

.campo-form {
    width: 100%;
    padding: 12px 20px;
    margin-bottom: 15px;
    border: 2px solid #666;
    border-radius: 25px;
    font-size: 1em;
    outline: none;
}


.campo-form:focus {
    border-color: #e15800;
}


/* BOTÃO */

.buton-entrar {
    background-color: #e15800;
    padding: 12px;
    border: none;
    border-radius: 20px;
    width: 100%;
    color: black;
    font-size: 20px;
    cursor: pointer;
    margin-bottom: 20px;
}


.buton-entrar:hover {
    background-color: #c94e00;
}


.buton-entrar:active {
    transform: translateY(4px);
}


/* ESQUECI A SENHA */

.esqueci {
    color: black;
    display: block;
    margin-top: 10px;
    text-decoration: underline;
    font-size: 1.1em;
}


.esqueci:hover {
    color: blue;
}


/* IMAGEM */

.uai_imagem {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 800px;
}


.uai_imagem img {
    width: 800px;
    max-width: 100%;
}


/* CAIXA MARROM */

.caixa-marrom {
    background-color: #4f3011;
    padding: 10px;
    border-radius: 20px;
    width: 60%;
    text-align: center;
    color: white;
    font-size: 22px;
    margin-top: -20px;
}


.laranja {
    color: #e15800;
}
