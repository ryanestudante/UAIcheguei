<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UAIcheguei</title>
  <style>
    :root {
      --laranja: #e15800;
      --marrom: #4f3011;
      --creme: #fffaf5;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      min-height: 100vh;
      margin: 0;
      overflow-x: hidden;
      background: #ff6500 url("CópiadeUAIcheguei.png") center / cover no-repeat fixed;
      color: #24170e;
      font-family: Arial, sans-serif;
    }

    .top-nav {
      position: fixed;
      top: 24px;
      right: 28px;
      z-index: 10;
      display: flex;
      gap: 12px;
    }

    .top-nav a {
      min-width: 142px;
      padding: 13px 20px;
      border: 2px solid var(--laranja);
      border-radius: 999px;
      background: #fff;
      color: var(--laranja);
      font-weight: bold;
      text-align: center;
      text-decoration: none;
      box-shadow: 0 5px 15px rgba(79, 48, 17, .18);
      transition: .25s ease;
    }

    .top-nav a:last-child {
      background: var(--laranja);
      color: #fff;
    }

    .top-nav a:hover {
      transform: translateY(-3px);
      background: var(--marrom);
      border-color: var(--marrom);
      color: #fff;
    }

    .pagina {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 100px 6vw 50px;
    }

    .logo-area {
      position: absolute;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: min(700px, 80vw);
      text-align: center;
      transform: translate(0, 0) scale(1);
      transition: transform .8s cubic-bezier(.2,.8,.2,1), opacity .5s ease;
    }

    .logo-area img {
      display: block;
      width: min(620px, 78vw);
      max-height: 58vh;
      object-fit: contain;
      filter: drop-shadow(0 14px 12px rgba(79, 48, 17, .2));
    }

    .slogan {
      margin: -18px 0 0;
      padding: 12px 25px;
      border-radius: 18px;
      background: var(--marrom);
      color: #fff;
      font-size: clamp(1.1rem, 2vw, 1.5rem);
      font-weight: bold;
    }

    .slogan span { color: #ff9b55; }

    .form-box {
      position: absolute;
      top: 50%;
      left: 50%;
      width: min(430px, calc(100% - 40px));
      padding: 34px 30px;
      border-radius: 24px;
      background: rgba(255, 255, 255, .97);
      box-shadow: 0 14px 35px rgba(79, 48, 17, .22);
      opacity: 0;
      pointer-events: none;
      transform: translate(100px, -50%) scale(.92);
      transition: opacity .5s ease .15s, transform .7s cubic-bezier(.2,.8,.2,1) .15s;
    }

    .form-box:target {
      opacity: 1;
      pointer-events: auto;
      transform: translate(-50%, -50%) scale(1);
    }

    .form-box:target ~ .logo-area {
      transform: translateX(-34vw) scale(.52);
    }

    .form-box h1 {
      margin: 0 0 8px;
      color: var(--laranja);
      text-align: center;
    }

    .form-box p { text-align: center; }

    .campo-form {
      width: 100%;
      margin: 8px 0;
      padding: 14px 17px;
      border: 2px solid #ddd;
      border-radius: 25px;
      font-size: 1rem;
      outline: none;
    }

    .campo-form:focus { border-color: var(--laranja); }

    .botao {
      width: 100%;
      margin-top: 12px;
      padding: 14px;
      border: 0;
      border-radius: 25px;
      background: var(--laranja);
      color: #fff;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
    }

    .troca {
      display: block;
      margin-top: 18px;
      color: var(--marrom);
      text-align: center;
    }

    .esqueci-senha {
      display: block;
      margin-top: 12px;
      color: var(--laranja);
      font-size: .95rem;
      text-align: center;
      text-decoration: none;
    }

    .esqueci-senha:hover,
    .troca:hover {
      text-decoration: underline;
    }

    @media (max-width: 700px) {
      .top-nav {
        top: 14px;
        right: 12px;
        left: 12px;
        justify-content: center;
      }

      .top-nav a {
        min-width: 0;
        flex: 1;
        padding: 11px 8px;
        font-size: .85rem;
      }

      .pagina { padding: 90px 20px 35px; }

      .logo-area {
        width: 90vw;
        transform: translate(0, 0) scale(1);
      }
      .logo-area img { width: 85vw; }

      .form-box:target ~ .logo-area {
        transform: translateY(-38vh) scale(.35);
      }

      .form-box:target {
        margin-top: 120px;
      }
    }
  </style>
</head>
<body>
  <nav class="top-nav" aria-label="Navegação principal">
    <a href="#cadastro">Fazer cadastro</a>
    <a href="#login">Entrar</a>
  </nav>

  <main class="pagina">
    <section class="form-box" id="cadastro" aria-label="Formulário de cadastro">
      <h1>Crie sua conta</h1>
      <p>Faça seu cadastro no UAIcheguei</p>
      <form>
        <input class="campo-form" type="text" placeholder="CPF" required>
        <input class="campo-form" type="email" placeholder="Email" required>
        <input class="campo-form" type="password" placeholder="Senha" required>
        <input class="campo-form" type="password" placeholder="Confirme a senha" required>
        <button class="botao" type="submit">Cadastrar</button>
      </form>
      <a class="troca" href="#login">Já tenho uma conta</a>
    </section>

    <section class="form-box" id="login" aria-label="Formulário de login">
      <h1>Entrar</h1>
      <p>Acesse sua conta UAIcheguei</p>
            <form>
        <input class="campo-form" type="email" placeholder="Email" required>
        <input class="campo-form" type="password" placeholder="Senha" required>
        <button class="botao" type="submit">Entrar</button>
      </form>
      <a class="esqueci-senha" href="#recuperar">Esqueci minha senha</a>
      <a class="troca" href="#cadastro">Ainda não tenho cadastro</a>
    </section>

    <section class="form-box" id="recuperar" aria-label="Recuperação de senha">
      <h1>Recupere sua senha</h1>
      <p>Informe seu email para receber as instruções de recuperação.</p>
      <form>
        <input class="campo-form" type="email" placeholder="Email" required>
        <button class="botao" type="submit">Enviar instruções</button>
      </form>
      <a class="troca" href="#login">Voltar para entrar</a>
    </section>

    <section class="logo-area" aria-label="UAIcheguei">
      <img src="https://uploads.onecompiler.io/44g7ujbgc/1787314084228/C%C3%B3pia_de_UAIcheguei__2_-removebg-preview.png" alt="Logo UAIcheguei">
      <p class="slogan">O melhor lugar para se pedir comida <span>em Minas</span></p>
    </section>
  </main>
</body>
</html>
