<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>UAIcheguei - Informações do Usuário</title>

<style>
*{
    margin:0;
    padding:0;
}

body{
    font-family:Arial;
    background:#fffaf7;
    color:#222;
}

#topo{
    height:140px;
    background:white;
    border-bottom:1px solid #ddd;
}

#cabecalho{
    height:140px;
    display:flex;
    align-items:center;
    padding:0 45px;
}

#logo{
    width:130px;
    height:130px;
}

#linha{
    height:80px;
    border-left:2px solid #ddd;
    margin-left:25px;
    margin-right:25px;
}

#endereco{
    width:180px;
}

#endereco p{
    margin:4px;
    font-size:13px;
}

#endereco strong{
    font-size:20px;
}

#endereco .rua{
    color:#ff6500;
    font-weight:bold;
}

#pesquisa{
    width:390px;
    height:55px;
    margin-left:40px;
    padding:0 20px;
    border:2px solid #222;
    border-radius:30px;
    font-size:16px;
}

#acoes{
    display:flex;
    gap:25px;
    margin-left:30px;
}

.acao{
    text-align:center;
    font-size:13px;
}

.icone{
    display:block;
    font-size:30px;
}

.acao:hover{
    color:#ff6500;
}

#perfil{
    width:70px;
    height:70px;
    margin-left:50px;
    border-radius:50%;
    overflow:hidden;
}

#perfil img{
    width:100%;
    height:100%;
}

#menu{
    height:55px;
    background:white;
    border-bottom:2px solid #ff6500;
    text-align:center;
    padding-top:2px;
}

#menu a{
    display:inline-block;
    padding:18px;
    color:#222;
    text-decoration:none;
    font-size:14px;
    font-weight:bold;
    border-right:1px solid #ddd;
}

#menu a:hover{
    color:#ff6500;
}

#principal{
    width:1050px;
    margin:20px auto;
}

#titulo{
    display:flex;
    align-items:center;
    margin-bottom:15px;
}

#titulo-icone{
    width:45px;
    height:45px;
    background:#ff6500;
    color:white;
    border-radius:50%;
    text-align:center;
    line-height:45px;
    font-size:25px;
    margin-right:12px;
}

#titulo h1{
    font-size:21px;
}

#titulo p{
    color:#777;
    font-size:12px;
    margin-top:4px;
}

#formulario{
    background:white;
    padding:25px;
    border-radius:25px;
    border:1px solid #ddd;
}

.secao{
    display:flex;
    align-items:center;
    color:#ff6500;
    border-bottom:2px solid #ff6500;
    padding:8px;
    margin-bottom:15px;
}

.secao span{
    font-size:24px;
    margin-right:10px;
}

.secao h2{
    font-size:19px;
}

.linha{
    display:flex;
    gap:18px;
    margin-bottom:15px;
}

.campo{
    display:flex;
    flex-direction:column;
}

.campo label{
    color:#777;
    font-size:14px;
    font-weight:bold;
    margin-bottom:5px;
}

.campo input{
    height:36px;
    padding:0 10px;
    border:2px solid #aaa;
    border-radius:10px;
    font-size:14px;
}

.campo input:focus{
    border-color:#ff6500;
    outline:none;
}

.nome{
    width:38%;
}

.data{
    width:22%;
}

.cpf{
    width:38%;
}

.usuario{
    width:38%;
    margin-bottom:20px;
}

.endereco{
    width:55%;
}

.email{
    width:43%;
}

.contato{
    width:38%;
}

.botoes{
    text-align:right;
    margin-top:25px;
}

.botao{
    padding:12px 25px;
    border:0;
    border-radius:25px;
    font-weight:bold;
}

#cancelar{
    background:#eee;
    color:#555;
}

#salvar{
    background:#ff6500;
    color:white;
}

#salvar:hover{
    background:#e95700;
}

@media(max-width:1100px){
    #principal{
        width:90%;
    }

    #pesquisa{
        width:280px;
    }

    #perfil{
        margin-left:20px;
    }
}

@media(max-width:800px){
    #topo,
    #cabecalho{
        height:auto;
    }

    #cabecalho{
        padding:15px;
        flex-wrap:wrap;
    }

    #pesquisa{
        width:100%;
        margin:15px 0;
    }

    #linha{
        display:none;
    }

    #acoes{
        margin-left:auto;
    }

    #perfil{
        margin-left:20px;
    }

    #menu{
        overflow:auto;
        white-space:nowrap;
    }

    .linha{
        display:block;
    }

    .nome,
    .data,
    .cpf,
    .usuario,
    .endereco,
    .email,
    .contato{
        width:100%;
        margin-bottom:15px;
    }
}
</style>
</head>

<body>

<div id="topo">

<div id="cabecalho">

<img id="logo" src="imagem/logo.png" alt="Logo UAIcheguei">

<div id="linha"></div>

<div id="endereco">
<p>Entregar em</p>
<strong>Minha Casa</strong>
<p class="rua">Rua ----------------</p>
</div>

<input id="pesquisa" type="text" placeholder="O que você quer comer hoje?">

<div id="acoes">

<div class="acao">
<span class="icone">♡</span>
Favoritos
</div>

<div class="acao">
<span class="icone">🛒</span>
Carrinho
</div>

</div>

<div id="perfil">
<img src="imagem/perfil.jpg" alt="Perfil">
</div>

</div>

</div>

<div id="menu">

<a href="index.html">⌂ Início</a>
<a href="#">Restaurantes</a>
<a href="#">Lanches</a>
<a href="#">Pizza</a>
<a href="#">Japonesa</a>
<a href="#">Açaí</a>
<a href="#">Doces</a>
<a href="#">Promoções</a>

</div>

<div id="principal">

<div id="titulo">

<div id="titulo-icone">♙</div>

<div>
<h1>Informações de usuário</h1>
<p>Mantenha seus dados sempre atualizados para uma melhor experiência.</p>
</div>

</div>

<div id="formulario">

<div class="secao">
<span>♙</span>
<h2>Dados pessoais</h2>
</div>

<div class="linha">

<div class="campo nome">
<label>Nome completo</label>
<input type="text" placeholder="Digite seu nome completo">
</div>

<div class="campo data">
<label>Data de nascimento</label>
<input type="text" placeholder="xx/xx/xxxx">
</div>

<div class="campo cpf">
<label>CPF</label>
<input type="text" placeholder="000.000.000-00">
</div>

</div>

<div class="campo usuario">
<label>Nome de usuário</label>
<input type="text" placeholder="Escolha um nome de usuário">
</div>

<div class="secao">
<span>📍</span>
<h2>Entrega</h2>
</div>

<div class="linha">

<div class="campo endereco">
<label>Endereço</label>
<input type="text" placeholder="Estado/cidade/Bairro/Rua/Número da casa">
</div>

<div class="campo email">
<label>Email</label>
<input type="email" placeholder="seuemail@gmail.com">
</div>

</div>

<div class="campo contato">
<label>Contato</label>
<input type="text" placeholder="(00) 0000-0000">
</div>

<div class="botoes">

<button class="botao" id="cancelar">Cancelar</button>
<button class="botao" id="salvar">Salvar alterações</button>

</div>

</div>

</div>

</body>
</html>
