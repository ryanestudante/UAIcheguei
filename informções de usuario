<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>UAIcheguei - Informações do Usuário</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background-color:#fff8f3;
    color:#222;
}

/* CABEÇALHO */

.cabecalho{
    width:100%;
    height:140px;
    background-color:white;
    border-bottom:1px solid #e5e5e5;
}

.cabecalho-conteudo{
    width:100%;
    height:100%;
    display:flex;
    align-items:center;
    padding:0 45px;
    gap:28px;
}

.logo-area{
    display:flex;
    align-items:center;
}

.logo{
    width:130px;
    height:130px;
    object-fit:contain;
}

.divisao{
    width:2px;
    height:82px;
    background-color:#e2e2e2;
}

/* ENDEREÇO */

.endereco{
    min-width:185px;
    display:flex;
    align-items:center;
    gap:12px;
}

.icone-local{
    font-size:30px;
    color:#ff6500;
}

.texto-endereco{
    display:flex;
    flex-direction:column;
    gap:2px;
}

.texto-endereco span{
    font-size:13px;
    font-weight:bold;
}

.texto-endereco strong{
    font-size:20px;
}

.texto-endereco small{
    color:#ff6500;
    font-size:13px;
    font-weight:bold;
}

/* PESQUISA */

.pesquisa{
    width:390px;
    height:70px;
    margin-left:70px;
    padding:0 20px;
    display:flex;
    align-items:center;
    border:2px solid #222;
    border-radius:40px;
    background-color:#fafafa;
}

.icone-pesquisa{
    font-size:28px;
    margin-right:15px;
}

.pesquisa input{
    width:100%;
    border:none;
    outline:none;
    background-color:transparent;
    font-size:16px;
}

.pesquisa input::placeholder{
    color:#777;
}

/* AÇÕES */

.acao{
    min-width:75px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:4px;
    cursor:pointer;
}

.icone-acao{
    font-size:36px;
}

.acao span:last-child{
    font-size:15px;
}

.acao:hover{
    color:#ff6500;
}

/* PERFIL */

.perfil{
    width:78px;
    height:78px;
    border-radius: 50%;
    overflow:hidden;
    border:2px solid #eee;
    margin-left:130px;
}

.perfil img{
    width:100%;
    height:100%;
    object-fit:cover;
}

/* MENU */

.menu{
    width:100%;
    height:57px;
    display:flex;
    align-items:center;
    justify-content:center;
    background-color:white;
    border-bottom:2px solid #ff6500;
}

.menu-conteudo{
    width:91%;
    max-width:1110px;
    height:54px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    background-color:white;
    
}

.menu-item{
    height:40px;
    padding:0 19px;
    display:flex;
    align-items:center;
    gap:10px;
    color:#222;
    text-decoration:none;
    border-right:1px solid #ccc;
    transition:.2s;
}

.menu-item:last-child{
    border-right:none;
}

.menu-item:hover,.menu-item.ativo{
    color:#ff6500;
}

.menu-icone{
    font-size:21px;
}

.menu-item span:last-child{
    font-size:14px;
    font-weight:bold;
}

/* PRINCIPAL */

.principal{
    min-height:calc(100vh - 197px);
    padding:0 40px 40px;
    position:relative;
    overflow:hidden;
    background-color:#fffaf7;
}

.principal::before{
    content:"";
    position:absolute;
    width:430px;
    height:430px;
    right:-150px;
    bottom:-260px;
    border-radius:50%;
    background-color:#ffd9c1;
}

.principal::after{
    content:"";
    position:absolute;
    width:270px;
    height:270px;
    left:-150px;
    bottom:-100px;
    border-radius:50%;
    background-color:#ffd9c1;
}

/* TÍTULO */

.titulo-pagina{
    width:100%;
    max-width:1050px;
    height:60px;
    margin:auto;
    display:flex;
    align-items:center;
    gap:12px;
    position:relative;
    z-index:2;
}

.titulo-icone{
    width:43px;
    height:43px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    background-color:#ff6500;
    color:white;
    font-size:25px;
}

.titulo-pagina h1{
    font-size:21px;
    margin-bottom:2px;
}

.titulo-pagina p{
    font-size:12px;
    color:#777;
}

/* FORMULÁRIO */

.formulario{
    width:100%;
    max-width:1050px;
    margin:auto;
    padding:25px 12px;
    position:relative;
    z-index:2;
    background-color:white;
    border-radius:30px;
    box-shadow:0 8px 30px rgba(0,0,0,.04);
}

.secao{
    width:100%;
}

.titulo-secao{
    width:100%;
    height:39px;
    display:flex;
    align-items:center;
    gap:12px;
    padding-left:8px;
    margin-bottom:7px;
    border-bottom:2px solid #ff6500;
}

.titulo-secao span{
    color:#ff6500;
    font-size:28px;
}

.titulo-secao h2{
    color:#ff6500;
    font-size:20px;
}

/* CAMPOS */

.linha{
    width:100%;
    display:flex;
    gap:18px;
    padding:0 4px;
}

.campo{
    display:flex;
    flex-direction:column;
    gap:5px;
}

.campo label{
    color:#aaa5a5;
    font-size:16px;
    font-weight:bold;
    padding-left:3px;
}

.campo input{
    height:36px;
    padding:0 10px;
    border:2px solid #afa7a7;
    border-radius:12px;
    outline:none;
    background-color:white;
    color:#333;
    font-size:16px;
    transition:.2s;
}

.campo input::placeholder{
    color:#aaa5a5;
}

.campo input:hover{
    border-color:#888;
}

.campo input:focus{
    border-color:#ff6500;
    box-shadow:0 0 0 3px rgba(255,101,0,.1);
}

/* TAMANHOS */

.campo-nome{
    width:38%;
}

.campo-data{
    width:22%;
}

.campo-cpf{
    width:38%;
}

.usuario{
    width:38%;
    margin-top:17px;
}

.entrega{
    margin-top:20px;
}

.campo-endereco{
    width:45%;
}

.campo-email{
    width:38%;
}

.contato{
    width:38%;
    margin-top:17px;
}

/* BOTÕES */

.botoes{
    width:100%;
    margin-top:25px;
    display:flex;
    justify-content:flex-end;
    gap:12px;
    padding:0 4px;
}

.botao{
    height:44px;
    padding:0 25px;
    border:none;
    border-radius:25px;
    font-size:15px;
    font-weight:bold;
    cursor:pointer;
    transition:.2s;
}


.cancelar{
    background-color:#eee;
    color:#555;
}

.cancelar:hover{
    background-color:#ddd;
}

.salvar{
    background-color:#ff6500;
    color:white;
    box-shadow:0 5px 15px rgba(255,101,0,.2);
}

.salvar:hover{
    background-color:#e95700;
    transform:translateY(-2px);
}

/* TABLET */

@media(max-width:1100px){

    .cabecalho-conteudo{
        padding:0 20px;
        gap:15px;
    }

    .logo{
        width:105px;
        height:105px;
    }

    .endereco{
        min-width:150px;
    }

    .texto-endereco strong{
        font-size:17px;
    }

    .pesquisa{
        width:300px;
    }

    .menu-item{
        padding:0 10px;
    }

    .principal{
        padding-left:25px;
        padding-right:25px;
    }
}

/* TABLET PEQUENO */

@media(max-width:850px){

    .cabecalho{
        height:auto;
    }

    .cabecalho-conteudo{
        min-height:100px;
        height:auto;
        flex-wrap:wrap;
        padding:10px 20px;
    }

    .logo{
        width:90px;
        height:90px;
    }

    .divisao{
        display:none;
    }

    .endereco{
        flex:1;
    }

    .pesquisa{
        order:5;
        width:100%;
        height:50px;
        margin:0 0 5px;
    }

    .acao span:last-child{
        display:none;
    }

    .perfil{
        width:60px;
        height:60px;
    }

    .menu{
        overflow-x:auto;
        justify-content:flex-start;
    }

    .menu-conteudo{
        min-width:850px;
    }

    .linha{
        flex-wrap:wrap;
    }

    .campo-nome,
    .campo-data,
    .campo-cpf,
    .campo-endereco,
    .campo-email{
        width:48%;
    }
}

/* CELULAR */

@media(max-width:600px){

    .principal{
        padding:0 12px 30px;
    }

    .titulo-pagina{
        height:70px;
    }

    .titulo-pagina h1{
        font-size:18px;
    }

    .titulo-pagina p{
        font-size:11px;
    }

    .formulario{
        padding:20px 10px;
        border-radius:22px;
    }

    .linha{
        flex-direction:column;
        gap:15px;
    }

    .campo-nome,
    .campo-data,
    .campo-cpf,
    .campo-endereco,
    .campo-email,
    .usuario,
    .contato{
        width:100%;
    }

    .titulo-secao h2{
        font-size:18px;
    }

    .botoes{
        flex-direction:column;
    }

    .botao{
        width:100%;
    }

    .texto-endereco strong{
        font-size:15px;
    }

    .texto-endereco span,
    .texto-endereco small{
        font-size:11px;
    }
}

</style>
</head>

<body>

<header class="cabecalho">

    <div class="cabecalho-conteudo">

        <div class="logo-area">
            <img src="imagem/logo.png" alt="Logo UAIcheguei" class="logo">
        </div>

        <div class="divisao"></div>

        <div class="endereco">

            <div class="icone-local">
                ♧
            </div>

            <div class="texto-endereco">
                <span>Entregar em</span>
                <strong>Minha Casa</strong>
                <small>Rua ----------------</small>
            </div>

        </div>

        <div class="pesquisa">

            <span class="icone-pesquisa">
                ⌕
            </span>

            <input type="text" placeholder="O que você quer comer hoje?">

        </div>

        <div class="acao">

            <span class="icone-acao">
                ♡
            </span>

            <span>
                Favoritos
            </span>

        </div>

        <div class="acao">

            <span class="icone-acao">
                🛒
            </span>

            <span>
                Carrinho
            </span>

        </div>

        <div class="perfil">

            <img src="imagem/perfil.jpg" alt="Foto do perfil">

        </div>

    </div>

</header>


<nav class="menu">

    <div class="menu-conteudo">

        <a href="#" class="menu-item ativo">
            <span class="menu-icone">⌂</span>
            <span>Início</span>
        </a>

        <a href="#" class="menu-item">
            <span>Restaurantes</span>
        </a>

        <a href="#" class="menu-item">
            <span>Lanches</span>
        </a>

        <a href="#" class="menu-item">
            <span>Pizza</span>
        </a>

        <a href="#" class="menu-item">
            <span>Japonesa</span>
        </a>

        <a href="#" class="menu-item">
            <span>Açaí</span>
        </a>

        <a href="#" class="menu-item">
            <span>Doces</span>
        </a>

        <a href="#" class="menu-item">
            <span>Promoções</span>
        </a>

    </div>

</nav>


<main class="principal">

    <div class="titulo-pagina">

        <div class="titulo-icone">
            ♙
        </div>

        <div>
            <h1>Informações de usuário</h1>
            <p>Mantenha seus dados sempre atualizados para uma melhor experiência.</p>
        </div>

    </div>


    <section class="formulario">

        <div class="secao">

            <div class="titulo-secao">
                <span>♙</span>
                <h2>Dados pessoais</h2>
            </div>

            <div class="linha">

                <div class="campo campo-nome">
                    <label for="nome">Nome completo</label>
                    <input type="text" id="nome" placeholder="Digite seu nome completo">
                </div>

                <div class="campo campo-data">
                    <label for="data">Data de nascimento</label>
                    <input type="text" id="data" placeholder="xx/xx/xxxx">
                </div>

                <div class="campo campo-cpf">
                    <label for="cpf">CPF</label>
                    <input type="text" id="cpf" placeholder="000.000.000-00">
                </div>

            </div>

            <div class="campo usuario">
                <label for="usuario">Nome de usuário</label>
                <input type="text" id="usuario" placeholder="Escolha um nome de usuário">
            </div>

        </div>


        <div class="secao entrega">

            <div class="titulo-secao">
                <span>♧</span>
                <h2>Entrega</h2>
            </div>

            <div class="linha">

                <div class="campo campo-endereco">
                    <label for="endereco">Endereço</label>
                    <input type="text" id="endereco" placeholder="Estado/cidade/Bairro/Rua/Número da casa">
                </div>

                <div class="campo campo-email">
                    <label for="email">Email</label>
                    <input type="email" id="email" placeholder="seuemail@gmail.com">
                </div>

            </div>

            <div class="campo contato">
                <label for="telefone">Contato</label>
                <input type="tel" id="telefone" placeholder="(00) 0000-0000">
            </div>

        </div>


        <div class="botoes">

            <button type="button" class="botao cancelar">
                Cancelar
            </button>

            <button type="button" class="botao salvar">
                Salvar alterações
            </button>

        </div>

    </section>

</main>

</body>
</html>
